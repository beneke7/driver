{
  "schema": "landscape-driver.history-jump.v1",
  "status": "short_mechanism_screen_complete_long_horizon_next",
  "target": {
    "optimizer": "AdamW",
    "landscapes": [
      "delayed_copy",
      "phase_switch",
      "text_shard"
    ],
    "development_seeds": [0, 1],
    "heldout_seeds": [2],
    "architecture": {
      "parameters": 85350912,
      "width": 768,
      "layers": 12,
      "heads": 12,
      "vocab_size": 128,
      "context": 128,
      "batch_size": 128
    }
  },
  "trace": {
    "record_every_steps": 4,
    "history_steps": 16,
    "fields": [
      "loss",
      "loss_slope",
      "loss_second_difference",
      "gradient_norm",
      "update_norm",
      "gradient_update_alignment",
      "parameter_norm",
      "role_gradient_norms",
      "role_update_norms",
      "adam_momentum_norms",
      "adam_variance_norms",
      "data_cursor"
    ],
    "store": "compact per-step telemetry plus recent AdamW updates by tensor role; full checkpoints only at branch and jump boundaries"
  },
  "actions": {
    "kind": "history_jump",
    "horizons_steps": [8, 16, 32],
    "blends": [0.25, 0.5, 1.0],
    "basis": "recent_adamw_updates_by_role",
    "advance_data_cursor": true,
    "probe_after_jump": true,
    "recovery": "adamw_fallback"
  },
  "driver": {
    "backbone": "numerical_mlp_then_gru_if_history_signal_requires_it",
    "selection_rule": "choose_by_heldout_action_ranking_and_driver_cost",
    "outputs": [
      "future_update_coefficients",
      "future_loss",
      "uncertainty",
      "recovery_risk"
    ],
    "online_adapter": "small_per_run"
  },
  "long_horizon_maneuver": {
    "status": "design_ready_not_yet_run",
    "target_conditions": [
      {
        "name": "control_85m",
        "parameters": 85350912,
        "role": "existing_reproducible_control"
      },
      {
        "name": "overparameterized_candidate",
        "parameters": "profiled_70m_to_160m",
        "role": "test_condition_not_assumed_better"
      }
    ],
    "data": {
      "source": "versioned_TinyStories_or_FineWeb_Edu_shard",
      "status": "not_downloaded",
      "locked_capability_stream": true
    },
    "measurements": [
      "post_recovery_loss_slope",
      "heldout_loss_area",
      "tokens_and_wall_to_quality",
      "locked_endpoint_capability",
      "total_target_driver_probe_recovery_cost"
    ],
    "promotion_requires": "fresh_seeds_and_changed_data_or_architecture_holdout"
  },
  "split": "whole_trajectory",
  "promotion": "not_evaluated"
}
